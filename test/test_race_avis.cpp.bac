#include <infiniband/verbs_exp.h>
#include <numa.h>

#include <algorithm>
#include <atomic>
#include <cinttypes>
#include <thread>

#include "Common.h"
#include "DSMAdaptor.h"
#include "DSMCache.h"
#include "PerThread.h"
#include "WRLock.h"
#include "avis/AvisAdaptor.h"
#include "avis/avis.h"
#include "avis/debug.h"
#include "bench/DataFrame.h"
#include "bench/experiment.h"
#include "gflags/gflags.h"
#include "glog/logging.h"
#include "memory/dsm_allocator.h"
#include "patronus/RdmaAdaptor.h"
#include "range/v3/view/take_last.hpp"
#include "rdmacpp/QP_Debug.h"
#include "thirdparty/racehashing/debug.h"
#include "thirdparty/racehashing/kv_block.h"
#include "thirdparty/racehashing/race.h"
#include "thirdparty/racehashing/slot.h"
#include "util/Hexdump.hpp"
#include "util/Tracer.h"
#include "util/gflags_def.h"

using namespace patronus::hash;

using HashKey = ::hash::HashKey;

using RaceHashingT = RaceHashing<4, 512, 8>;
using HandleT = typename RaceHashingT::Handle;

struct PCLS
{
    HandleT::pointer handle;
    avis::AvisHandle::Pointer avis_handle;
};

struct Spec
{
    using PCLS = PCLS;
};

class Experiment : public ::bench::DSMCoroExperiment<Spec>
{
public:
    using Base = ::bench::DSMCoroExperiment<Spec>;
    using BLS = typename Base::BLS;
    using Provider = avis::AvisHandle::Provider;

    Experiment(const avis::Config &avis_config) : avis_config_(avis_config)
    {
        DSMConfig dsm_config;
        dsm_config.worker_nr = 0;
        dsm_ = DSM::getInstance(dsm_config);
        dsm_->registerThread();

        server_nid_ = dsm_->getClusterSize() - 1;
    }
    bool is_client() const
    {
        // return dsm_->get_node_id() != server_nid_;
        return dsm_->get_node_id() == 0;
    }
    bool is_server() const
    {
        return dsm_->get_node_id() == server_nid_;
    }

    void set_handle(BLS &bls /* out */,
                    CoroContext *ctx,
                    const avis::Policy &policy)
    {
        auto &pcls = bls.persistent_coroutine();
        if (is_client())
        {
            pcls.avis_handle = avis::AvisHandle::make_ptr(
                dsm_,
                avis_config_,
                std::vector<Provider>{avis_provider_},
                policy,
                ctx);
            pcls.avis_handle->update_metas();

            auto race_handle_conf = RaceHashingConfigFactory::get_unprotected(
                "test", false /* force match */);
            auto race_avis_adaptor = avis::AvisAdaptor::make_ptr(
                pcls.avis_handle, nullptr /* manager */);
            pcls.handle = HandleT::new_instance(race_meta_raddr_,
                                                race_handle_conf,
                                                false /* auto expand */,
                                                race_avis_adaptor);
            pcls.handle->init();
        }
    }
    void init_server()
    {
        CHECK(is_server());
        // init server avis
        auto provider_id = dsm_->get_node_id();
        auto primary_alloc = dsm_->get_dsm_allocator();
        auto secondary_alloc = dsm_->get_secondary_allocator();
        LOG_IF(INFO, avis_manager_) << "[debug] !!! " << PRE(avis_manager_);

        avis_manager_ = avis::AvisManager::make_ptr(provider_id,
                                                    primary_alloc,
                                                    secondary_alloc,
                                                    dsm_,
                                                    avis_config_,
                                                    1 /* init pool nr */);
        Provider provider{
            .node_id = (uint32_t) dsm_->get_node_id(),
            .rkey = dsm_->get_base_rkey(0 /* dir_id */),
            .meta_addr = (uint64_t) avis_manager_->meta_addr(),
        };
        dsm_->put("avis:provider", provider, 100ms);

        // init server RACE
        race_conf_.initial_subtable = 4;
        // deprecated for Avis
        race_conf_.g_kvblock_pool_addr = nullptr;
        race_conf_.g_kvblock_pool_size = 0;

        auto server_adaptor =
            avis::AvisAdaptor::make_ptr(nullptr, avis_manager_);
        auto server_allocator = server_adaptor->get_manager_allocator();
        table_ = RaceHashingT::new_instance(
            server_adaptor, server_allocator, race_conf_);
        auto meta_raddr = table_->meta_raddr();
        dsm_->put("race:meta_raddr", meta_raddr, 100ms);
        LOG(INFO) << "PUT: " << PRE(meta_raddr);
        LOG(INFO) << PRE(avis_manager_);
    }

    void thread_init(BLS &bls, size_t thread_nr) override
    {
        dsm_->registerThread();
        Base::thread_init(bls, thread_nr);
    }
    DSM::pointer get_dsm() const override
    {
        return dsm_;
    }
    void on_start_bench(BLS &bls, const Config &conf) override
    {
        static int epoch_ = 0;
        if (is_server())
        {
            init_server();
        }

        dsm_->keeper_barrier("epoch-" + std::to_string(epoch_++), 100ms);

        avis_provider_ = dsm_->get<Provider>("avis:provider", 100ms);
        race_meta_raddr_ = dsm_->get<GlobalAddress>("race:meta_raddr", 100ms);
        LOG(INFO) << "GET: " << PRE(avis_provider_) << ", "
                  << PRE(race_meta_raddr_);
        CHECK(!race_meta_raddr_.is_null());

        Base::on_start_bench(bls, conf);
    }

    void on_thread_end_bench(BLS &bls, const Config &conf) override
    {
        Base::on_thread_end_bench(bls, conf);
    }

    void exit() override
    {
        df_.dump(FLAGS_binary, FLAGS_exec_meta);
    }

    void benchmark_coroutine(BLS &bls,
                             const Config &conf,
                             CoroContext &ctx,
                             ::bench::StopToken::pointer token,
                             bool) override
    {
        // auto tid = dsm_->get_thread_id();
        std::ignore = bls;
        auto &pcls = bls.persistent_coroutine();

        auto kv_size = conf.get<size_t>("kv_size");
        auto key_rng = conf.get<size_t>("key_rng");
        auto get_ratio = conf.get<size_t>("get_ratio");
        auto delete_ratio = conf.get<size_t>("delete_ratio");
        auto avis_policy = conf.get<avis::Policy>("avis_policy");

        CHECK(dsm_->hasRegistered());

        std::unordered_map<std::string, std::string> kvs;

        std::string key(sizeof(HashKey), ' ');
        HashKey &hkey = *(HashKey *) key.data();
        hkey.nid = dsm_->get_node_id();
        hkey.tid = dsm_->get_thread_id();
        hkey.cid = ctx.coro_id();
        std::string value(8, 'a');

        auto expect_value_size =
            KVBlockView::kvblock_fit_value(kv_size, key.size());

        util::TraceManager tm;

        if (is_client())
        {
            set_handle(bls, &ctx, avis_policy);
        }

        while (!token->stop_requested())
        {
            if (is_client())
            {
                hkey.value = fast_pseudo_rand_int(key_rng - 1);
                fast_pseudo_fill_buf(value.data(), value.size());

                bool is_get = fast_pseudo_bool_with_prob(get_ratio / 100.0);
                bool is_delete =
                    fast_pseudo_bool_with_prob(delete_ratio / 100.0);

                auto trace = tm.trace("");

                trace.set("key", key);

                if (is_get)
                {
                    BufferView get_v;
                    // auto trace = tm.trace("get");
                    // trace.set("key", key);
                    // auto rc = handle->get(key, get_v, trace);
                    if constexpr (kEnableHistory)
                    {
                        ::hash::history.current().add(Record{
                            .ma = kEvent,
                            .ua = kRead,
                            .raddr = GlobalAddress{},
                            .key = hkey,
                        });
                    }
                    auto view = pcls.handle->prepare_kv(key.size(), 0);
                    view.fill_key(key);

                    std::string expected_value;
                    if (kvs.contains(key))
                    {
                        expected_value = kvs[key];
                    }
                    trace.set("expected", expected_value);
                    trace.set("op", "get");

                    auto rc = pcls.handle->get(get_v, trace);

                    if constexpr (kEnableHistory)
                    {
                        ::hash::history.current().add(Record{
                            .ma = kEvent,
                            .ua = kRead,
                            .raddr = GlobalAddress(0, (uintptr_t) 0xff),
                            .key = hkey,
                        });
                    }
                    if (kvs.count(key))
                    {
                        if (unlikely(rc != RC::kOk ||
                                     !get_v.to_sv().starts_with(kvs[key])))
                        {
                            auto get_sv = get_v.to_sv();
                            LOG(ERROR)
                                << "expect " << PRE(RC::kOk) << ", got "
                                << PRE(rc) << ", expect " << PRE(kvs[key])
                                << ", got `" << get_sv.substr(0, 8) << "`"
                                << std::endl
                                << PRE(key, hkey) << std::endl
                                << util::Hexdump(get_v.data(), get_v.size());
                            LOG(WARNING) << PRE(trace.kv());
                            enter_error(bls, token, key, hkey, expected_value);
                        }
                    }
                    else
                    {
                        CHECK_EQ(rc, RC::kNotFound)
                            << PRE(ctx, key, hkey, value, get_v);
                    }
                }
                else if (is_delete)
                {
                    trace.set("op", "del");
                    auto view = pcls.handle->prepare_kv(key.size(), 0);
                    view.fill_key(key);

                    auto rc = pcls.handle->del(trace);
                    if (kvs.count(key))
                    {
                        CHECK_EQ(rc, RC::kOk);
                        kvs.erase(key);
                    }
                    else
                    {
                        CHECK_EQ(rc, RC::kNotFound);
                    }
                }
                else
                {
                    // auto trace = tm.trace("put");
                    // trace.set("key", key);
                    // handle->put(key, value, trace).expect(RC::kOk);
                    if constexpr (kEnableHistory)
                    {
                        ::hash::history.current().add(Record{
                            .ma = kEvent,
                            .ua = kCAS,
                            .raddr = GlobalAddress{},
                            .key = hkey,
                        });
                    }
                    auto view =
                        pcls.handle->prepare_kv(key.size(), expect_value_size);
                    view.fill_key_value(key, value);

                    trace.set("op", "put");
                    DCHECK(trace.enabled());

                    auto rc = pcls.handle->put(trace);
                    if (avis_manager_ && avis_manager_->pool_nr() == 0)
                    {
                        LOG(ERROR) << "Find anomalies: " << PRE(key) << ", "
                                   << PRE(value);
                        enter_error(bls, token, key, hkey, "TODO...");
                    }
                    if (likely(rc == RC::kOk))
                    {
                        kvs[key] = value;
                    }
                    else
                    {
                        CHECK_EQ(rc, RC::kNoMem);
                        LOG(WARNING) << "Run out of memory. Stop.";
                        token->core().request_stop();
                        run_out_of_mem_err_ = true;
                        err_cid_ = ctx.coro_id();
                    }
                }
                token->complete_task(1);
            }
        }
    }

    void enter_error(BLS &bls,
                     ::bench::StopToken::pointer token,
                     const std::string &key,
                     HashKey hkey,
                     std::string expected_val)
    {
        auto &pcls = bls.persistent_coroutine();
        token->core().request_stop();
        LOG(WARNING) << "on first known error " << PRE(table_);
        LOG(WARNING) << "on first known error " << PRE(avis_manager_) << ", "
                     << avis_manager_->pool_nr();

        // auto last =
        //     rdma::history.current().history() | ranges::views::take_last(20);
        auto last = rdma::history.current().take(20);
        LOG(INFO) << "last RDMA ops: " << PRE(last);

        // wait for everyone has finished
        std::this_thread::sleep_for(100ms);

        std::lock_guard<std::mutex> mu(lk_);
        if (!err_)
        {
            // LOG(ERROR) << "expect " << PRE(RC::kOk) << ", got " << PRE(rc)
            //            << ", expect " << PRE(kvs[key]) << ", got "
            //            << PRE(get_v);
            err_ = true;
            err_key_ = key;
            hkey_ = hkey;
            {
                LOG(ERROR) << "????? unbelievable! try again!!!!";
                util::TraceManager tm;
                BufferView get_v;
                auto view = pcls.handle->prepare_kv(key.size(), 0);
                view.fill_key(key);
                auto trace = tm.trace("");
                trace.set("key", key);
                trace.set("expected", expected_val);
                trace.set("op", "get");
                auto rc = pcls.handle->get(get_v, trace);
                if (unlikely(rc != RC::kOk ||
                             !get_v.to_sv().starts_with(expected_val)))
                {
                    LOG(WARNING)
                        << "[again] expect " << PRE(RC::kOk) << ", got "
                        << PRE(rc) << ", expect " << expected_val << ", got `"
                        << get_v.to_sv().substr(0, 8) << "`" << std::endl
                        << PRE(key, hkey) << std::endl
                        << util::Hexdump(get_v.data(), get_v.size());
                }
            }

            {
                avis::validate_history();
            }

            using namespace ranges;

            auto filter =
                views::filter([this](const auto &r)
                              { return r->key == hkey_ && r->ma == kQuery; });

            auto f = ::hash::history.current().take(10, filter);

            // LOG(INFO) << PRE(f);
            for (const auto &r : f)
            {
                LOG(INFO) << PRE(r);
            }
            if (unlikely(f.empty()))
            {
                LOG(FATAL) << "Error on unwrap: history empty: ";
            }
            raddr_ = f.front()->raddr;
            LOG(ERROR) << PRE(raddr_);
            pcls.handle->get_adaptor()->debug_explain_raddr(raddr_);
        }
    }

    void on_end_bench(const ResultRecord &res,
                      BLS &bls,
                      const Config &conf) override
    {
        df_.reg_result(res, conf);
        if (is_server())
        {
            LOG(INFO) << PRE(table_);
            LOG(WARNING) << PRE(table_->utilization());
            auto pools = avis_manager_->explain_allocatable_pools();
            for (const auto &pool : pools)
            {
                LOG(INFO) << "pool utilization: " << pool.utilization();
                //   << std::endl
                //   << pool;
            }
        }

        if (is_client())
        {
            using namespace ranges;

            if (unlikely(err_))
            {
                LOG(INFO) << "Rollback and debugging";
                LOG(INFO) << "Set up debug avis handle...";

                // avoid any miswrite
                {
                    auto this_key = views::filter(
                        [this](const auto &r)
                        { return r->key == hkey_ || r->raddr == raddr_; });
                    auto related = ::hash::history.all(this_key);
                    auto r =
                        related | views::filter([this](const auto &r)
                                                { return r.tid != hkey_.tid; });
                    LOG_IF(FATAL, !r.empty())
                        << "** other thread touch my key: " << PRE(r);
                }

                const auto &policy = conf.get<avis::Policy>("avis_policy");
                auto avis_handle = avis::AvisHandle::make_ptr(
                    dsm_,
                    avis_config_,
                    std::vector<Provider>{avis_provider_},
                    policy,
                    nullptr /* ctx */);
                avis_handle->update_metas();

                // report possible miswrite: at QP level
                {
                    auto avis_addr = avis::AvisAddress::from_raddr(raddr_);
                    auto translated = avis_handle->translate_addr(avis_addr);
                    LOG(ERROR) << PRE(raddr_, avis_addr, (void *) translated);

                    auto this_addr = views::filter(
                        [=](const auto &r)
                        {
                            auto op = r->wr.exp_opcode;
                            if (op == IBV_EXP_WR_RDMA_READ ||
                                op == IBV_EXP_WR_RDMA_WRITE)
                            {
                                return r->wr.wr.rdma.remote_addr == translated;
                            }
                            else if (
                                op ==
                                    IBV_EXP_WR_EXT_MASKED_ATOMIC_CMP_AND_SWP ||
                                op ==
                                    IBV_EXP_WR_EXT_MASKED_ATOMIC_FETCH_AND_ADD)
                            {
                                return r->wr.ext_op.masked_atomics
                                           .remote_addr == translated;
                            }
                            else
                            {
                                LOG(FATAL) << "** TODO: this op: " << PRE(op);
                            }
                            return false;
                        });
                    auto related_his = rdma::history.take(100, this_addr);
                    LOG(ERROR) << "Related QP history:";
                    for (const auto &r : related_his)
                    {
                        LOG(INFO) << PRE(r);
                    }
                    if (!related_his.empty())
                    {
                        auto front = related_his.front();
                        auto &op = front->wr.ext_op.masked_atomics.wr_data
                                       .inline_data.op.cmp_swap;
                        auto compare = op.compare_val;
                        auto swap = op.swap_val;

                        LOG(ERROR) << PRE(util::TaggedPtrImpl<void>(compare));
                        LOG(ERROR) << PRE(util::TaggedPtrImpl<void>(swap));
                    }
                    LOG(ERROR) << "[end] Related QP history:";
                }

                auto filter = views::filter(
                    [this](const auto &r)
                    { return r->key == hkey_ || r->raddr == raddr_; });

                auto all_his = ::hash::history.take(20, filter);

                LOG(INFO) << "Global history:";
                for (const auto &r : all_his)
                {
                    LOG(INFO) << r;
                }
                LOG(INFO) << "[end] Global history:";

                auto target = all_his |
                              views::filter([](const auto &r)
                                            { return r->ma == kQuery; }) |
                              to<std::vector>();

                avis::AvisAddress kvblock_avis_addr;
                GlobalAddress kvblock_raddr;
                {
                    auto data = target.front();
                    LOG(INFO) << PRE(data);
                    auto raddr = data.t_.raddr;
                    auto avis_addr = avis::AvisAddress::from_raddr(raddr);
                    LOG(INFO) << PRE(raddr) << ", " << PRE(avis_addr);
                    auto buffer = dsm_->get_rdma_buffer(8);
                    memset(buffer.buffer, 0, 8);

                    avis_handle->prepare_read(buffer.buffer, avis_addr, 8);
                    avis_handle->commit();

                    LOG(INFO) << PRE(raddr) << std::endl
                              << util::Hexdump(buffer.buffer, 128);
                    uint64_t value = *(uint64_t *) buffer.buffer;
                    util::TaggedPtrImpl<void> ptr(value);
                    LOG(INFO) << PRE((void *) (uint64_t) ptr.u8_h()) << ", "
                              << PRE((void *) (uint64_t) ptr.u8_l()) << ", "
                              << PRE((void *) ptr.ptr());

                    auto hash = hash_impl(err_key_.data(), err_key_.size());
                    auto m = hash_m(hash);
                    auto fp = hash_fp(hash);
                    LOG(INFO) << PRE((void *) m) << ", " << PRE((void *) fp);
                    auto expect_fp = fp;
                    auto slot_fp = ptr.u8_h();
                    LOG_IF(ERROR, expect_fp != slot_fp)
                        << "** the expected fp: "
                        << (void *) (uint64_t) expect_fp
                        << " from hash: " << (void *) hash
                        << " from err_key_: " << PRE(err_key_, err_key_.size())
                        << ", tranlsated: "
                        << *(hash::HashKey *) err_key_.data();

                    CHECK_EQ((void *) (uint64_t) expect_fp,
                             (void *) (uint64_t) slot_fp)
                        << "** aha! fp mismatch";

                    kvblock_raddr =
                        GlobalAddress::from_raw((uint64_t) ptr.ptr());
                    kvblock_avis_addr =
                        avis::AvisAddress::from_raddr(kvblock_raddr);
                    LOG(ERROR) << PRE(kvblock_raddr, kvblock_avis_addr);
                }
                {
                    auto kvblock_buffer = dsm_->get_rdma_buffer(64);
                    LOG(ERROR) << "Fetching buffer: " << PRE(kvblock_avis_addr);

                    avis_handle->prepare_read(
                        kvblock_buffer.buffer, kvblock_avis_addr, 64);
                    avis_handle->commit();

                    KVBlock &block = *(KVBlock *) kvblock_buffer.buffer;
                    LOG(INFO)
                        << PRE(block.key_len) << ", " << PRE(block.value_len)
                        << ", " << PRE((void *) block.hash);
                    std::string got_key(block.key_len, ' ');
                    std::string got_value(block.value_len, ' ');
                    memcpy(got_key.data(), block.buf, block.key_len);
                    memcpy(got_value.data(),
                           block.buf + block.key_len,
                           block.value_len);
                    if (got_key == err_key_)
                    {
                        LOG(INFO) << "** key match!! great, go on";
                        LOG(INFO) << "Key is " << *(HashKey *) got_key.data();
                        LOG(INFO) << "Value is " << got_value.substr(0, 8);
                        LOG(INFO)
                            << "[bench] " << PRE(kvblock_raddr) << std::endl
                            << util::Hexdump(kvblock_buffer.buffer, 128);
                    }
                    else
                    {
                        LOG(ERROR) << "** mismatch!!";
                    }
                }
            }
        }
        Base::on_end_bench(res, bls, conf);
    }

private:
    DSM::pointer dsm_;
    size_t server_nid_;

    Provider avis_provider_;
    GlobalAddress race_meta_raddr_;

    // avis
    avis::Config avis_config_;

    // server
    RaceHashingConfig race_conf_;
    typename RaceHashingT::pointer table_;  // for server
    avis::AvisManager::Pointer avis_manager_;

    std::mutex lk_;
    Perthread<std::unordered_map<std::string, std::list<std::string>>> history_;
    std::string err_key_;
    HashKey hkey_;
    GlobalAddress raddr_;
    bool err_{false};

    bool run_out_of_mem_err_{false};
    uint32_t err_cid_{};

    bench::ResultDataFrame df_;
};

int main(int argc, char *argv[])
{
    init_gflags(argc, argv);
    avis::Config avis_config;
    Experiment exp(avis_config);

    bench::ConfigFactory f;
    // f.configure_thread_nr({1, 2, 4, 8, 12, 16, 20, 24, 28, 32,
    // kMaxAppThread});
    // f.configure_thread_nr({1, 2, 8, 16});
    f.configure_thread_nr({16});
    f.configure_coro_nr({1});
    // f.configure_thread_nr({1});
    // f.configure_coro_nr({1});

    f.add_option<size_t>("kv_size", {4_KB});
    f.add_option<size_t>("key_rng", {512});  // this is per client
    f.add_option<size_t>("get_ratio", {80});
    f.add_option<size_t>("delete_ratio", {0});
    auto pf = avis::PolicyFactory{};
    [[maybe_unused]] auto unsync_limit =
        avis_config.huge_frame_size / avis_config.base_frame_size;
    auto policy = pf.batch_policy(unsync_limit);
    // auto policy = pf.baseline_policy();
    f.add_option<avis::Policy>("avis_policy", {policy});
    auto configs = f.generate_configs();

    exp.configure_monitor(200ms, 20);
    // exp.disable_monitor();
    exp.launch_coroutines(configs);

    LOG(INFO) << "PASS.";
}