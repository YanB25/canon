#include <numa.h>

#include <atomic>
#include <cinttypes>
#include <thread>

#include "DSMCache.h"
#include "WRLock.h"
#include "avis/avis.h"
#include "bench/experiment.h"
#include "gflags/gflags.h"
#include "glog/logging.h"
#include "memory/dsm_allocator.h"
#include "util/gflags_def.h"

struct C
{
    std::unordered_set<avis::AvisAddress> set;
    OnePassBucketMonitor<uint64_t> bucket{0, MAX_MACHINE, 1};
    std::unique_ptr<avis::AvisHandle> handle;
};

inline void validate_buffer_not_overlapped(const avis::AvisAddress &lhs,
                                           const avis::AvisAddress &rhs,
                                           size_t size)
{
    Buffer lhs_buf((char *) (uint64_t) lhs.offset(), size);
    Buffer rhs_buf((char *) (uint64_t) rhs.offset(), size);
    validate_buffer_not_overlapped(lhs_buf, rhs_buf);
}

inline void validate_buffer_not_overlapped(
    const std::unordered_set<avis::AvisAddress> &set, size_t size)
{
    for (auto it = set.begin(); it != set.end(); ++it)
    {
        for (auto it2 = std::next(it); it2 != set.end(); ++it2)
        {
            validate_buffer_not_overlapped(*it, *it2, size);
        }
    }
}

template <typename T>
inline auto random_evict(std::unordered_set<T> &set)
{
    DCHECK(!set.empty());
    auto it = set.begin();
    size_t limit = set.size();
    auto adv = fast_pseudo_rand_int(0, limit - 1);
    std::advance(it, adv);
    auto ret = *it;
    set.erase(it);
    return ret;
}

struct Spec
{
    using PCLS = C;
};

class Experiment : public ::bench::DSMCoroExperiment<Spec>
{
public:
    using Base = ::bench::DSMCoroExperiment<Spec>;
    using BLS = typename Base::BLS;
    Experiment(const avis::Config &avis_config) : avis_config_(avis_config)
    {
        DSMConfig dsm_config;
        dsm_config.worker_nr = 0;
        dsm_ = DSM::getInstance(dsm_config);
        dsm_->registerThread();

        auto primary_alloc = dsm_->get_dsm_allocator();
        auto secondary_alloc = dsm_->get_secondary_allocator();

        auto provider_id = dsm_->get_node_id();
        m_ = std::make_unique<avis::AvisManager>(provider_id,
                                                 primary_alloc,
                                                 secondary_alloc,
                                                 dsm_,
                                                 avis_config_,
                                                 1 /* init pool nr */);
        auto *meta = m_->meta_addr();
        dsm_->put("meta", meta, 100ms);
        auto *get_meta = dsm_->get<avis::AvisMeta *>("meta", 100ms);

        providers_.emplace_back(Provider{
            .node_id = (uint32_t) dsm_->get_node_id(),
            .rkey = dsm_->get_rkey(dsm_->get_node_id(), 0 /* dir_id */),
            .meta_addr = (uint64_t) get_meta});
    }
    DSM::pointer get_dsm() const override
    {
        return dsm_;
    }

    void thread_init(BLS &bls, size_t thread_nr) override
    {
        dsm_->registerThread();

        Base::thread_init(bls, thread_nr);
    }
    void benchmark_coroutine(BLS &bls,
                             const Config &conf,
                             [[maybe_unused]] CoroContext &ctx,
                             ::bench::StopToken::pointer token,
                             bool) override
    {
        auto &pcls = bls.persistent_coroutine();

        size_t alloc_size = conf.get<size_t>("alloc_size");
        auto ongoing_limit = conf.get<size_t>("ongoing_limit");
        auto policy = conf.get<avis::Policy>("policy");

        pcls.handle = std::make_unique<avis::AvisHandle>(
            dsm_, avis_config_, providers_, policy, &ctx);
        pcls.handle->update_metas();

        while (!token->stop_requested())
        {
            while (pcls.set.size() >= ongoing_limit)
            {
                auto addr = random_evict(pcls.set);
                pcls.handle->free(addr, alloc_size);
            }
            auto addr = pcls.handle->alloc(alloc_size);
            CHECK(pcls.set.emplace(addr).second) << "addr duplicated.";

            token->complete_task(1);
        }
        LOG(INFO) << "private validation: " << PRE(pcls.set.size());
    }
    void on_thread_start_bench(BLS &bls, const Config &conf) override
    {
        alloc.current() = std::make_shared<memory::DSMAllocator>(dsm_.get());
        Base::on_thread_start_bench(bls, conf);
    }
    void on_coro_end_bench(BLS &bls, const Config &conf) override
    {
        auto &pclc = bls.persistent_coroutine();

        auto alloc_size = conf.get<size_t>("alloc_size");
        auto &s = pclc.set;
        for (auto it = s.begin(); it != s.end(); ++it)
        {
            for (auto it2 = std::next(it); it2 != s.end(); ++it2)
            {
                validate_buffer_not_overlapped(*it, *it2, alloc_size);
            }
        }

        // combine
        {
            std::lock_guard<std::mutex> lk(mu_);
            for (const auto &addr : s)
            {
                CHECK(all_set.insert(addr).second)
                    << "addr insert not take place: duplicated";
            }
            s.clear();
        }

        Base::on_thread_end_bench(bls, conf);
    }
    void on_end_bench(const ::bench::ResultRecord &res,
                      BLS &bls,
                      const Config &conf) override
    {
        // validate not overlapped
        auto alloc_size = conf.get<size_t>("alloc_size");
        LOG(INFO) << "begin validation for size: " << all_set.size();
        for (auto it = all_set.begin(); it != all_set.end(); ++it)
        {
            for (auto it2 = std::next(it); it2 != all_set.end(); ++it2)
            {
                validate_buffer_not_overlapped(*it, *it2, alloc_size);
            }
        }

        Base::on_end_bench(res, bls, conf);
    }

    void exit() override
    {
        for (size_t p = 0; p < m_->pool_nr(); ++p)
        {
            LOG(INFO) << m_->explain_pool(p);
        }
    }

private:
    DSM::pointer dsm_;
    Perthread<std::shared_ptr<memory::DSMAllocator>> alloc;

    std::unique_ptr<avis::AvisManager> m_;

    const avis::Config &avis_config_;
    using Provider = avis::AvisHandle::Provider;
    std::vector<Provider> providers_;

    std::mutex mu_;
    std::unordered_set<avis::AvisAddress> all_set;
};

int main(int argc, char *argv[])
{
    init_gflags(argc, argv);
    avis::Config avis_config;
    Experiment exp(avis_config);

    bench::ConfigFactory f;
    f.configure_thread_nr({16});
    f.configure_coro_nr({1});
    // f.add_option<size_t>("alloc_size", {4_KB});
    // f.add_option<size_t>("ongoing_limit", {1024});
    f.add_option<size_t>("alloc_size", {1_MB});
    f.add_option<size_t>("ongoing_limit", {32});
    auto pf = avis::PolicyFactory{};
    f.add_option<avis::Policy>("policy", {pf.default_policy()});
    auto configs = f.generate_configs();

    exp.configure_monitor(400ms, 10);
    exp.launch_coroutines(configs);

    LOG(INFO) << "PASS.";
}